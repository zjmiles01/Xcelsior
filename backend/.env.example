# Local development settings template. Copy to `.env` (gitignored) and edit:
#     cp .env.example .env
# Pydantic-settings reads `.env` with the XCELSIOR_ prefix (app/core/config.py).
#
# Authentication is per-user accounts with session cookies (M10, ADR-007) —
# there is no shared token to configure. Sign up in the UI to create an
# account; the session lives in an HTTP-only cookie the server sets.

# Optional overrides (defaults shown in app/core/config.py):
# XCELSIOR_DATABASE_URL=postgresql+psycopg://xcelsior:xcelsior@localhost:5432/xcelsior
# XCELSIOR_ENVIRONMENT=development
# XCELSIOR_RATE_LIMIT_PER_MINUTE=120
# XCELSIOR_SESSION_TTL_DAYS=14
